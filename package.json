{
  "name": "vplayer",
  "version": "6.0.0",
  "private": true,
  "description": "A weather-vane instrument panel for music. Angle carries time.",
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev public --compatibility-date=2026-05-01",
    "deploy": "wrangler pages deploy public --project-name=vplayer",
    "tail": "wrangler pages deployment tail --project-name=vplayer",
    "db:init": "wrangler d1 execute vplayer --remote --file=./schema.sql",
    "db:local": "wrangler d1 execute vplayer --local --file=./schema.sql",
    "lint": "eslint .",
    "check": "eslint . --max-warnings=0",
    "db:migrate": "wrangler d1 execute vplayer --remote --file=./migrations/0001-strip-chart-id-prefix.sql"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
